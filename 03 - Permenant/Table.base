views:
  - type: table
    name: Table
    order:
      - file.ctime
      - file.basename
      - file.backlinks
      - file.tags
    sort:
      - property: file.tags
        direction: DESC
      - property: file.links
        direction: ASC
      - property: tags
        direction: ASC
      - property: file.backlinks
        direction: ASC
    cardSize: 170
    imageFit: contain
    imageAspectRatio: 1.2
    columnSize:
      file.ctime: 70
  - type: cards
    name: View
    filters:
      or:
        - file.name.startsWith("Man's")
        - and:
            - file.name.contains("fuck")
    order:
      - file.name
    sort: []
    cardSize: 170
    image: file.file
    imageFit: contain
    imageAspectRatio: 1.1
