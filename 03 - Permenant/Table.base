views:
  - type: cards
    name: Table
    order:
      - file.name
      - file.links
      - file.tags
    sort:
      - property: file.tags
        direction: DESC
      - property: file.links
        direction: ASC
      - property: tags
        direction: ASC
      - property: file.backlinks
        direction: ASC
    cardSize: 170
    imageFit: contain
    imageAspectRatio: 1.2
  - type: cards
    name: View
    filters:
      and:
        - file.ext.endsWith("png")
        - file.fullname.startsWith("Man")
    order:
      - file.name
    sort:
      - property: file.path
        direction: ASC
    cardSize: 120
    image: file.file
    imageFit: contain
    imageAspectRatio: 1.1
