formulas:
  Untitled: |
    aliases
  Untitled 2: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.startsWith("04 - Daily")
    order:
      - file.name
      - file.backlinks
    sort:
      - property: file.name
        direction: ASC
    imageAspectRatio: 0.25
    cardSize: 210
    columnSize:
      file.name: 95
    showProperties: false
    multipleColumns: false
    maxCardWidth: 800
    markers: none
  - type: table
    name: View
    filters:
      and:
        - file.folder.contains("Daily")
    order:
      - file.name
      - file.backlinks
