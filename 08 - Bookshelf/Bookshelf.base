formulas:
  properties: formula.properties
views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "08 - Bookshelf"
        - file.ext == "md"
        - file.name != "Books list"
    order:
      - title
      - author
    sort:
      - property: file.basename
        direction: ASC
    cardSize: 120
    image: note.cover
    imageFit: ""
    imageAspectRatio: 1.5
    rowHeight: medium
